<Window x:Class="NativeViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RhaView"
        Width="1000"
        Height="700"
        MinWidth="600"
        MinHeight="400"
        Background="#FFF7F8FA"
        Language="de-DE"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Öffnen…" InputGestureText="F4 / Strg+O" Click="OpenButton_Click" />
                <MenuItem Header="Neues _Fenster" InputGestureText="Strg+N" Click="NewWindowMenuItem_Click" />
                <MenuItem x:Name="RecentFilesMenuItem" Header="Zuletzt geöffnet" SubmenuOpened="RecentFilesMenuItem_SubmenuOpened" />
                <Separator />
                <MenuItem Header="_Speichern" InputGestureText="F2 / Strg+S" Click="SaveMenuItem_Click" />
                <MenuItem Header="Speichern _unter…" InputGestureText="Strg+Umschalt+S" Click="SaveAsMenuItem_Click" />
                <Separator />
                <MenuItem Header="_Beenden" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Ansicht">
                <MenuItem x:Name="PrettyPrintMenuItem" Header="Formatierte Ansicht" IsCheckable="True" IsChecked="True" Click="PrettyPrintMenuItem_Click" />
                <MenuItem x:Name="MarkdownRenderedMenuItem" Header="Markdown-Darstellung" IsCheckable="True" IsChecked="True" IsEnabled="False" Click="MarkdownRenderedMenuItem_Click" />
                <MenuItem x:Name="CsvPreviewMenuItem" Header="CSV-Tabellenansicht" IsCheckable="True" IsChecked="True" IsEnabled="False" Click="CsvPreviewMenuItem_Click" />
                <MenuItem x:Name="WordWrapMenuItem" Header="Zeilenumbruch" IsCheckable="True" Click="WordWrapMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Bearbeiten">
                <MenuItem x:Name="UndoMenuItem" Header="_Rückgängig" InputGestureText="Strg+Z" Click="UndoMenuItem_Click" IsEnabled="False" />
                <MenuItem x:Name="RedoMenuItem" Header="_Wiederholen" InputGestureText="Strg+Y" Click="RedoMenuItem_Click" IsEnabled="False" />
                <Separator />
                <MenuItem Header="A_usschneiden" InputGestureText="Strg+X" Click="CutMenuItem_Click" />
                <MenuItem Header="_Kopieren" InputGestureText="Strg+C" Click="CopyMenuItem_Click" />
                <MenuItem Header="_Einfügen" InputGestureText="Strg+V" Click="PasteMenuItem_Click" />
                <Separator />
                <MenuItem Header="Alles auswählen" InputGestureText="Strg+A" Click="SelectAllMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Suche">
                <MenuItem Header="Suche ein-/ausblenden…" InputGestureText="F6 / Strg+F" Click="SearchMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Einstellungen">
                <MenuItem Header="Schriftgröße">
                    <MenuItem Header="Vergrößern" InputGestureText="Strg++" Click="IncreaseFontMenuItem_Click" />
                    <MenuItem Header="Verkleinern" InputGestureText="Strg+-" Click="DecreaseFontMenuItem_Click" />
                    <MenuItem Header="Zurücksetzen" Click="ResetFontMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="Einrückung">
                    <MenuItem x:Name="Indent2MenuItem" Header="2 Leerzeichen" IsCheckable="True" Tag="2" Click="IndentSizeMenuItem_Click" />
                    <MenuItem x:Name="Indent3MenuItem" Header="3 Leerzeichen (Standard)" IsCheckable="True" Tag="3" Click="IndentSizeMenuItem_Click" />
                    <MenuItem x:Name="Indent4MenuItem" Header="4 Leerzeichen" IsCheckable="True" Tag="4" Click="IndentSizeMenuItem_Click" />
                    <MenuItem x:Name="Indent8MenuItem" Header="8 Leerzeichen" IsCheckable="True" Tag="8" Click="IndentSizeMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="Benutzerdefiniert…" Click="CustomIndentSizeMenuItem_Click" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Hilfe">
                <MenuItem Header="_Befehlszeile…" Click="CommandLineHelpMenuItem_Click" />
                <MenuItem Header="Tastenkürzel" Click="KeyboardHelpMenuItem_Click" />
                <Separator />
                <MenuItem Header="Über _RhaView" Click="AboutMenuItem_Click" />
                <MenuItem Header="_Lizenz" Click="LicenseMenuItem_Click" />
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#FFE1E5EA" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="UndoButton" Content="Rückgängig" ToolTip="Letzte Änderung rückgängig machen (Strg+Z)" Padding="10,7" Margin="4,0" Click="UndoMenuItem_Click" IsEnabled="False" />
                    <Button Content="Speichern" ToolTip="Datei speichern (F2 oder Strg+S)" Padding="10,7" Margin="4,0" Click="SaveMenuItem_Click" />
                    <Button Content="Öffnen…" ToolTip="Datei öffnen (F4 oder Strg+O)" Padding="10,7" Margin="4,0" Click="OpenButton_Click" />
                    <ToggleButton x:Name="PrettyPrintButton" Content="Formatiert" ToolTip="Formatierte Ansicht" Padding="6,7" Margin="2,0" IsChecked="True" IsEnabled="False" Click="PrettyPrintButton_Click" />
                    <ToggleButton x:Name="RawTextButton" Content="Rohtext" ToolTip="Unformatierten Text anzeigen" Padding="6,7" Margin="2,0" IsEnabled="False" Click="RawTextButton_Click" />
                    <Button x:Name="DecreaseIndentButton" Content="-1" ToolTip="Einrückung um ein Leerzeichen verringern" Padding="7,7" Margin="2,0" Click="DecreaseIndentButton_Click" IsEnabled="False" />
                    <Button x:Name="IncreaseIndentButton" Content="+1" ToolTip="Einrückung um ein Leerzeichen erhöhen" Padding="7,7" Margin="2,0" Click="IncreaseIndentButton_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="FileNameText" Text="Datei öffnen oder hier ablegen" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="FilePathText" Margin="0,3,0,0" Foreground="#FF68717D" Text="JSON, XML, Markdown, HTML, CSS, CSV und Text" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#FFE1E5EA" BorderThickness="0,1,0,0" Padding="12,7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="FileNameStatusText" Foreground="#FF35404B" Margin="8,0" />
                    <TextBlock x:Name="FileSizeText" Foreground="#FF68717D" Margin="8,0" />
                    <TextBlock x:Name="PositionText" Foreground="#FF68717D" Margin="8,0" />
                    <TextBlock x:Name="ModifiedText" Foreground="#FF35404B" Margin="8,0" />
                    <TextBlock x:Name="ClockStatusText"
                               Foreground="#FF68717D"
                               FontSize="10"
                               Margin="8,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="#FF68717D" Text="Bereit" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TabControl x:Name="DocumentTabs"
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        SelectionChanged="DocumentTabs_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <DockPanel>
                            <TabPanel IsItemsHost="True" />
                        </DockPanel>
                    </ControlTemplate>
                </TabControl.Template>
            </TabControl>
            <DockPanel x:Name="SearchPanel" Grid.Row="1" Margin="0,0,0,8" Visibility="Collapsed">
                <Button DockPanel.Dock="Right" Content="Schließen" Margin="8,0,0,0" Padding="10,5" Click="CloseSearchButton_Click" />
                <Button DockPanel.Dock="Right" Content="Weitersuchen" Padding="10,5" Click="FindNextButton_Click" />
                <Button DockPanel.Dock="Right" Content="Vorheriger Treffer" Padding="10,5" Click="FindPreviousButton_Click" />
                <CheckBox x:Name="RegexCheckBox"
                          DockPanel.Dock="Right"
                          Content="Regulärer Ausdruck"
                          VerticalAlignment="Center"
                          Margin="12,0"
                          Checked="SearchPatternMode_Checked"
                          Unchecked="SearchOptions_Changed" />
                <CheckBox x:Name="WildcardCheckBox"
                          DockPanel.Dock="Right"
                          Content="Stringmatch (*, ?)"
                          ToolTip="* steht für eine beliebige Zeichenfolge, ? für ein einzelnes Zeichen."
                          VerticalAlignment="Center"
                          Margin="12,0"
                          Checked="SearchPatternMode_Checked"
                          Unchecked="SearchOptions_Changed" />
                <CheckBox x:Name="MatchCaseCheckBox"
                          DockPanel.Dock="Right"
                          Content="Groß-/Kleinschreibung beachten"
                          VerticalAlignment="Center"
                          Margin="12,0"
                          Checked="SearchOptions_Changed"
                          Unchecked="SearchOptions_Changed" />
                <TextBox x:Name="SearchTextBox"
                         MinWidth="180"
                         Padding="7,5"
                         VerticalContentAlignment="Center"
                         ToolTip="Suchtext eingeben"
                         TextChanged="SearchTextBox_TextChanged"
                         KeyDown="SearchTextBox_KeyDown" />
            </DockPanel>
            <Grid x:Name="ViewGrid" Grid.Row="2">
                <TextBox x:Name="TextView"
                         Visibility="Visible"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         UndoLimit="500"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="14"
                         Padding="12"
                         BorderBrush="#FFE1E5EA"
                         Background="White"
                         SelectionBrush="#FFFFD54F"
                         SelectionOpacity="0.85"
                         TextChanged="TextView_TextChanged"
                         SelectionChanged="TextView_SelectionChanged" />
                <FlowDocumentScrollViewer x:Name="MarkdownView"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="16"
                                          Background="White"
                                          BorderBrush="#FFE1E5EA"
                                          BorderThickness="1" />
                <DataGrid x:Name="CsvView"
                          Visibility="Collapsed"
                          IsReadOnly="True"
                          AutoGenerateColumns="True"
                          ColumnWidth="SizeToCells"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          FontFamily="Consolas"
                          FontSize="14"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
